# file, You can obtain one at http://mozilla.org/MPL/2.0/.

# The night runtime (the night_runtime_* C ABI AOT-generated code calls, the
# night value stack, interpreter dispatch into compiled bodies, and snapshot
# registration/activation/capture), folded into libjs under
# --enable-nightmonkey so the JS shell carries it.

include("../../js-config.mozbuild")
include("../../js-cxxflags.mozbuild")

UNIFIED_SOURCES += [
    "NightRegistration.cpp",
    "NightRuntime.cpp",
    "NightStack.cpp",
]

SOURCES += [
    # Own TUs (NOT unified): NightRuntimeSlots.cpp isolates heavy *-inl.h
    # includes from NightRuntime.cpp's hot-helper optimization (see
    # NightRuntimeSlots.h); the others pull *-inl.h headers too.
    "NightEntry.cpp",
    "NightGenerator.cpp",
    "NightInlineCaches.cpp",
    "NightInlineHeap.cpp",
    "NightOps.cpp",
    "NightRegExp.cpp",
    "NightRuntimeSlots.cpp",
    "NightSnapshotExtras.cpp",
]

if CONFIG["ENABLE_JS_NIGHTMONKEY_INPROCESS"]:
    SOURCES += [
        "NightInproc.cpp",
        "NightInprocHost.cpp",
    ]

EXPORTS += [
    "NightRuntime.h",
]

DEFINES["EXPORT_JS_API"] = True

LOCAL_INCLUDES += [
    "!../..",
    "../..",
]

FINAL_LIBRARY = "js"
