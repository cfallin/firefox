# The NightMonkey wasm shell: the JS shell compiled to wasm32-wasi with the
# night runtime linked in and wizer snapshot support. This build serves the
# snapshot production flow: wizer init registers the root script, and the
# `nightmonkey` host binary (built by this same config as a host tool)
# transforms the snapshot.
#
#   MOZCONFIG=js/src/night/configs/mozconfig-nightmonkey ./mach build
#
# Produces obj-nightmonkey/dist/bin/js (a wasm32-wasi command module) and
# obj-nightmonkey/dist/host/bin/nightmonkey (the AOT compiler).
ac_add_options --enable-project=js
ac_add_options --target=wasm32-unknown-wasi
ac_add_options --enable-js-shell
ac_add_options --enable-js-shell-wizer
ac_add_options --enable-nightmonkey
ac_add_options --disable-stdcxx-compat
ac_add_options --without-system-zlib
ac_add_options --without-intl-api
ac_add_options --disable-jit
ac_add_options --disable-shared-js
ac_add_options --disable-shared-memory
ac_add_options --disable-tests
ac_add_options --disable-clang-plugin
ac_add_options --disable-debug-symbols
ac_add_options --enable-optimize
ac_add_options --enable-jitspew

mk_add_options MOZ_OBJDIR=obj-nightmonkey
mk_add_options AUTOCLOBBER=1

export RUSTFLAGS="-Cdebuginfo=0"
